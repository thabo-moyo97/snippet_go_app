{{define "title"}}Edit Snippet{{end}}

{{define "main"}}
    {{with .Form}}
    <div class="max-w-2xl mx-auto">
        <form action='/snippet/{{.ID}}/edit' method='POST' class="mb-6">
            <input type='hidden' name='csrf_token' value='{{$.CSRFToken}}'>
            <input type='hidden' name='expires_at' value='{{createFormDate .ExpiresAt}}'>
            
            <div class="mb-6">
                <div class="w-full flex justify-between items-center">
                    <label class="block mb-2">Title:</label>
                    <div class="text-gray-600">
                        <span class="block">Archives on:</span>
                        {{humanDate .ExpiresAt}}
                    </div>
                </div>
                {{with .Errors.title}}
                    <label class="text-red-600 font-bold block mb-2">{{.}}</label>
                {{end}}
                <input type='text' name='title' value='{{.Title}}'
                       class="w-full p-3 border border-gray-200 rounded text-gray-600">
            </div>
            <div class="mb-6">
                <label class="block mb-2">Content:</label>
                {{with .Errors.content}}
                    <label class="text-red-600 font-bold block mb-2">{{.}}</label>
                {{end}}
                <textarea name='content'
                          class="w-full p-4 h-64 border border-gray-200 rounded text-gray-600">{{.Content}}</textarea>
            </div>
            <div class="mt-6">
                <input type='submit' value='Save'
                       class="bg-emerald-500 text-white px-6 py-3 rounded font-bold hover:bg-emerald-600 transition-colors cursor-pointer float-right">
            </div>
        </form>
        
        <!-- Add delete form -->
        <form action='/snippet/{{.ID}}/delete' method='POST' class="mt-4" 
              onsubmit="return confirm('Are you sure you want to delete this snippet?');">
            <input type='hidden' name='csrf_token' value='{{$.CSRFToken}}'>
            <button type="submit" 
                    class="bg-red-500 text-white px-6 py-3 rounded font-bold hover:bg-red-600 transition-colors cursor-pointer">
                Delete Snippet
            </button>
        </form>
    </div>
    {{else}}
    <div class="text-center text-gray-600">
        <p>No form data available.</p>
    </div>
    {{end}}
{{end}}