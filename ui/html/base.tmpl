{{define "base"}}
<!doctype html>
<html lang='en' class="h-full">
    <head>
        <meta charset='utf-8'>
        <title>{{template "title" .}} - Snippetbox</title>
        <link href="/static/css/output.css" rel="stylesheet">
        <link rel='shortcut icon' href='/static/img/favicon.ico' type='image/x-icon'>
        <link rel='stylesheet' href='https://fonts.googleapis.com/css?family=Ubuntu+Mono:400,700'>
    </head>
    <body class="h-full leading-normal bg-slate-50 text-slate-700 overflow-y-scroll font-mono">
        <header class="text-center border-b border-gray-200 overflow-auto py-8">
            <h1><a href='/' class="text-4xl font-bold bg-[url('/static/img/logo.png')] bg-no-repeat h-9 pl-12 relative text-slate-700 no-underline">Snippetbox</a></h1>
        </header>
        {{template "nav" .}}
        <main class="my-14 min-h-[calc(100vh-345px)] overflow-auto px-4 max-w-4xl mx-auto">
            {{with .Flash}}
                <div class='font-bold text-white bg-slate-700 p-4 mb-8 text-center rounded-md'>{{.}}</div>
            {{end}}
            {{template "main" .}}
        </main>
        <footer class="border-t border-gray-200 py-4 bg-gray-50 h-15 text-gray-600 text-center">
            Powered by <a href='https://golang.org/' class="text-emerald-500 hover:text-emerald-600 hover:underline">Go</a> in {{.CurrentYear}}
        </footer>
        <script src='/static/js/main.js' type='text/javascript'></script>
                <script>
            // Live reload WebSocket connection
            let ws;
            
            function connect() {
                ws = new WebSocket('wss://' + window.location.host + '/ws');
            
                ws.onopen = function(event) {
                    console.log('WebSocket connection opened', event);
                    ws.send('Hello Server!');
                };
                
                ws.onclose = function(event) {
                    console.log('WebSocket connection close', event);
                    setTimeout(connect, 1000); // Reconnect after 1 second
                };
                
                ws.onerror = function(error) {
                    console.error('WebSocket error:', error);
                };
                
                ws.onmessage = function(event) {
                    console.log('WebSocket message received', event);
                    const data = event.data
                    window.location.reload();
                };
            }
            
            connect();
        </script>

    </body>

</html>
{{end}}
