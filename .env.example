# Database Configuration
DB_HOST=db
DB_PORT=3306
DB_USER=web
DB_PASSWORD=pass
DB_NAME=snippetbox

# App Configuration
APP_PORT=8888
DEBUG_PORT=2345
APP_MODE=dev
CGO_ENABLED=1

# MySQL root password (for initial setup)
MYSQL_ROOT_PASSWORD=rootpass

# Connection string template
DSN=web:pass@tcp(db:3306)/snippetbox?parseTime=true&timeout=5s&readTimeout=5s&writeTimeout=5s&multiStatements=true 